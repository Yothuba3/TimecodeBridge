<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windowsでコンソールが付随しないようGUI形式にする（macOSでは Exe と同じ扱い） -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>TimecodeBridge2</Product>
    <AssemblyTitle>TimecodeBridge2</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimecodeBridge.Core\TimecodeBridge.Core.csproj" />
    <ProjectReference Include="..\TimecodeBridge.Windows\TimecodeBridge.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Info.plist">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimecodeBridge.App.Tests" />
  </ItemGroup>

</Project>

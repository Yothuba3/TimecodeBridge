<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimecodeBridge.App.ViewModels"
        x:Class="TimecodeBridge.App.Views.Dialogs.OscTriggerButtonEditDialog"
        Title="ボタン編集"
        Width="440" Height="460"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <Window.Styles>
        <!-- ダイアログ共通: フォントに対して枠が大きくならないよう入力欄をコンパクトにし、
             行内で引き伸ばされないよう上下センターに揃える -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>


    <Border Margin="12" Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
            CornerRadius="8" Padding="20">
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid.Styles>
                <Style Selector="TextBlock.Label">
                    <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>
            </Grid.Styles>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ラベル" Classes="Label" />
            <TextBox Grid.Row="0" Grid.Column="1" Name="LabelBox" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="OSCアドレス" Classes="Label" />
            <TextBox Grid.Row="1" Grid.Column="1" Name="OscAddressBox"
                     FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="OSC引数" Classes="Label" />
            <TextBox Grid.Row="2" Grid.Column="1" Name="OscArgsBox"
                     FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12"
                     ToolTip.Tip="例: i:1 f:0.5 s:hello (型:値 をスペース区切り、空白を含む文字列は s:&quot;hello world&quot;)" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="送信先ホスト" Classes="Label" VerticalAlignment="Top" />
            <Border Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="HostList" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HostSelection">
                                    <CheckBox Content="{CompiledBinding Name}"
                                              IsChecked="{CompiledBinding IsSelected}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Name="NoHostsHint" IsVisible="False"
                               Text="ホストが未登録です。&#10;先に「ホスト管理」からホストを追加してください"
                               Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <Button Name="DeleteButton" Content="削除" Padding="18,8"
                        HorizontalAlignment="Left" Click="OnDeleteClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="OK" Padding="24,8" Classes="accent"
                            Click="OnOkClick" IsDefault="True" />
                    <Button Content="キャンセル" Padding="24,8"
                            Click="OnCancelClick" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

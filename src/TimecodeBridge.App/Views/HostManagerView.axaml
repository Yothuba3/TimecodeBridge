<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimecodeBridge.App.ViewModels"
             xmlns:models="using:TimecodeBridge.Core.Models"
             x:Class="TimecodeBridge.App.Views.HostManagerView"
             x:DataType="vm:HostManagerViewModel"
             Background="Transparent">

    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="8" Padding="0">
        <Grid Margin="12" RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="3" Height="14" Background="{StaticResource AccentBrush}"
                        CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="ホスト管理" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundBrush}" />
            </StackPanel>

            <!-- Host List -->
            <ListBox Grid.Row="1" Name="HostList"
                     ItemsSource="{CompiledBinding Hosts}"
                     BorderThickness="1"
                     BorderBrush="{StaticResource BorderSubtleBrush}"
                     Background="Transparent">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:OscHost">
                        <Grid Margin="4,3" ColumnDefinitions="*,120,60,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{CompiledBinding Name}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource PrimaryForegroundBrush}"
                                       FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Text="{CompiledBinding IpAddress}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{CompiledBinding Port}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Margin="0,0,8,0" />
                            <CheckBox Grid.Column="3"
                                      IsChecked="{CompiledBinding IsEnabled, Mode=OneWay}"
                                      Content="有効"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Command="{Binding $parent[ListBox].((vm:HostManagerViewModel)DataContext).ToggleHostEnabledCommand}"
                                      CommandParameter="{CompiledBinding Id}" />
                            <Button Grid.Column="4" Content="編集" Padding="8,4" Margin="0,0,4,0"
                                    FontSize="11" VerticalAlignment="Center"
                                    Command="{Binding $parent[ListBox].((vm:HostManagerViewModel)DataContext).EditHostCommand}"
                                    CommandParameter="{CompiledBinding Id}" />
                            <Button Grid.Column="5" Content="Ping" Padding="8,4" Margin="0,0,4,0"
                                    FontSize="11" VerticalAlignment="Center"
                                    Command="{Binding $parent[ListBox].((vm:HostManagerViewModel)DataContext).PingHostCommand}"
                                    CommandParameter="{CompiledBinding Id}" />
                            <Button Grid.Column="6" Content="削除" Padding="8,4"
                                    FontSize="11" VerticalAlignment="Center"
                                    Command="{Binding $parent[ListBox].((vm:HostManagerViewModel)DataContext).RemoveHostCommand}"
                                    CommandParameter="{CompiledBinding Id}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Add Host Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Name="AddHostButton" Content="+ ホスト追加"
                        Command="{CompiledBinding AddHostCommand}"
                        Classes="accent"
                        Padding="14,7" FontSize="12" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

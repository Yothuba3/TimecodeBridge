<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimecodeBridge.App.ViewModels"
             xmlns:conv="using:TimecodeBridge.App.Converters"
             x:Class="TimecodeBridge.App.Views.OscTriggerPanelView"
             x:DataType="vm:OscTriggerPanelViewModel">

    <UserControl.Styles>
        <!-- セルボタン -->
        <Style Selector="Button.cell">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="2.5" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.cell.unconfigured">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.cell.flashing">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cell.flashing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- 実行モード＝武装状態を枠色でも識別できるようにする -->
    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="8" Margin="4" Padding="14"
            BorderBrush="{CompiledBinding IsPlayMode, Converter={x:Static conv:ValueConverters.PlayModeBorderBrush}}"
            BorderThickness="{CompiledBinding IsPlayMode, Converter={x:Static conv:ValueConverters.PlayModeBorderThickness}}">
        <Grid RowDefinitions="Auto,*">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="3" Height="14" Background="{StaticResource AccentBrush}"
                            CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="OSCポン出し" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center" />
                    <!-- 実行モードの常時バナー（Escで編集モードへ） -->
                    <Border Background="{StaticResource ErrorBrush}" CornerRadius="4"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            IsVisible="{CompiledBinding IsPlayMode}"
                            ToolTip.Tip="クリックで即送信されます。Escキーで編集モードへ戻ります">
                        <TextBlock Text="実行中 (Esc=編集)"
                                   FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="実行" GroupName="PonMode" Margin="0,0,8,0"
                                 VerticalAlignment="Center" FontSize="12"
                                 IsChecked="{CompiledBinding IsPlayMode}" />
                    <RadioButton Content="編集" GroupName="PonMode" Margin="0,0,10,0"
                                 VerticalAlignment="Center" FontSize="12"
                                 IsChecked="{CompiledBinding IsEditMode}" />
                    <TextBlock Text="行" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" />
                    <TextBox Text="{CompiledBinding Rows, UpdateSourceTrigger=LostFocus}" Width="40"
                             TextAlignment="Center" FontFamily="{StaticResource MonoFont}"
                             IsEnabled="{CompiledBinding IsEditMode}" />
                    <TextBlock Text="列" VerticalAlignment="Center" Margin="8,0,4,0"
                               Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" />
                    <TextBox Text="{CompiledBinding Columns, UpdateSourceTrigger=LostFocus}" Width="40"
                             TextAlignment="Center" FontFamily="{StaticResource MonoFont}"
                             IsEnabled="{CompiledBinding IsEditMode}" />
                </StackPanel>
            </StackPanel>

            <!-- Grid of trigger buttons -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="CellsControl" ItemsSource="{CompiledBinding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Name="CellsGrid" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OscTriggerCellViewModel">
                            <Button Classes="cell"
                                    Classes.unconfigured="{CompiledBinding !IsConfigured}"
                                    Classes.flashing="{CompiledBinding IsFlashing}"
                                    Margin="4" MinHeight="60"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((vm:OscTriggerPanelViewModel)DataContext).TriggerCellCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{CompiledBinding DisplayText}">
                                <TextBlock Text="{CompiledBinding DisplayText, Converter={x:Static conv:ValueConverters.CellLabel}}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

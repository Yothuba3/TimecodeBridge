<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimecodeBridge.App.ViewModels"
             xmlns:conv="using:TimecodeBridge.App.Converters"
             x:Class="TimecodeBridge.App.Views.RelayControlView"
             x:DataType="vm:RelayViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="ToggleButton#ContinuousToggle">
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ToggleButton#ContinuousToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton#ContinuousToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="8" Padding="0">
        <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="3" Height="14" Background="{StaticResource AccentBrush}"
                        CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="リレー制御" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundBrush}" />
            </StackPanel>

            <!-- OSC Address Pattern -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="OSC アドレスパターン" Margin="0,0,0,6" FontSize="11"
                           Foreground="{StaticResource SecondaryForegroundBrush}" />
                <TextBox Text="{CompiledBinding OscAddressPattern}"
                         MaxWidth="300" MinWidth="200" FontFamily="{StaticResource MonoFont}"
                         HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Continuous Mode -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="継続送信モード" Margin="0,0,0,6" FontSize="11"
                           Foreground="{StaticResource SecondaryForegroundBrush}" />
                <ToggleButton Name="ContinuousToggle"
                              Content="{CompiledBinding IsContinuousEnabled, Converter={x:Static conv:ValueConverters.BoolToToggleLabel}}"
                              IsChecked="{CompiledBinding IsContinuousEnabled}"
                              Padding="18,7"
                              HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Send Interval -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="送信間隔" Margin="0,0,0,6" FontSize="11"
                           Foreground="{StaticResource SecondaryForegroundBrush}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox Name="IntervalModeCombo" SelectedIndex="{CompiledBinding IntervalModeIndex}" Width="140" Margin="0,0,8,0">
                        <ComboBoxItem Content="EveryFrame" />
                        <ComboBoxItem Content="Custom" />
                    </ComboBox>
                    <TextBox Text="{CompiledBinding IntervalMs, UpdateSourceTrigger=LostFocus}"
                             Width="80"
                             IsEnabled="{Binding #IntervalModeCombo.SelectedIndex, Converter={x:Static conv:ValueConverters.IndexIsCustom}}" />
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12"
                               Foreground="{StaticResource SecondaryForegroundBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Target Hosts -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="送信先ホスト" Margin="0,0,0,6" FontSize="11"
                           Foreground="{StaticResource SecondaryForegroundBrush}" />
                <ItemsControl ItemsSource="{CompiledBinding HostSelections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostSelection">
                            <CheckBox Content="{CompiledBinding Name}"
                                      IsChecked="{CompiledBinding IsSelected}"
                                      Margin="0,3"
                                      IsCheckedChanged="OnHostCheckChanged" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="(ホストが登録されていません)"
                           Foreground="{StaticResource SecondaryForegroundBrush}"
                           FontSize="11" Margin="0,3,0,0"
                           IsVisible="{CompiledBinding HostSelections.Count, Converter={x:Static conv:ValueConverters.IsZero}}" />
            </StackPanel>

            <!-- One-Shot Trigger -->
            <StackPanel Grid.Row="5">
                <TextBlock Text="ワンショット送信" Margin="0,0,0,6" FontSize="11"
                           Foreground="{StaticResource SecondaryForegroundBrush}" />
                <Button Content="送信トリガー"
                        Command="{CompiledBinding TriggerOneShotCommand}"
                        Padding="18,7" FontSize="12"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

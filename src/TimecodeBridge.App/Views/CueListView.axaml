<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimecodeBridge.App.ViewModels"
             x:Class="TimecodeBridge.App.Views.CueListView"
             x:DataType="vm:CueListViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="TextBlock.colHeader">
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.colHeaderCell">
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <!-- 行スタイル: 下線・次キューのハイライト -->
        <Style Selector="ListBox#CueList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#CueList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
        </Style>
        <Style Selector="ListBox#CueList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
        </Style>
        <Style Selector="Border.cueRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style Selector="Border.cueRow.next">
            <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
        </Style>

        <!-- トリガー時の赤フラッシュ (WPFのFlashInストーリーボード相当) -->
        <Style Selector="Border.flashOverlay">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.flashOverlay.triggered">
            <Style.Animations>
                <Animation Duration="0:0:0.6" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.7" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
            CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,4,0">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Toolbar -->
            <DockPanel Grid.Row="0" Margin="12,10,12,6">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="14" Background="{StaticResource AccentBrush}"
                            CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="キューリスト" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center" />
                    <!-- 次キューの常時サマリー -->
                    <TextBlock Text="{CompiledBinding NextCueSummary}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="判定幅:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11"
                               ToolTip.Tip="タイムコードの揺らぎ（ジッタ）とジャンプを判定する許容フレーム数。&#10;・この幅までの逆行はジッタとして無視され、キューは二重発火しません&#10;・この幅を超えて過去へ戻ると「巻き戻し」とみなし、そこより後のキューを再び発火できるようにします&#10;・この幅を超える前方ジャンプは「頭出し」とみなし、途中のキューを発火させません&#10;・ノイズの多いLTC信号では大きめ（3〜5）にすると安定します" />
                    <TextBox Text="{CompiledBinding TriggerWindowFrames}"
                             Width="36" FontSize="11" VerticalAlignment="Center"
                             HorizontalContentAlignment="Center" Padding="4,3"
                             ToolTip.Tip="タイムコードの揺らぎ（ジッタ）とジャンプを判定する許容フレーム数。&#10;・この幅までの逆行はジッタとして無視され、キューは二重発火しません&#10;・この幅を超えて過去へ戻ると「巻き戻し」とみなし、そこより後のキューを再び発火できるようにします&#10;・この幅を超える前方ジャンプは「頭出し」とみなし、途中のキューを発火させません&#10;・ノイズの多いLTC信号では大きめ（3〜5）にすると安定します" />
                    <TextBlock Text="f" VerticalAlignment="Center" Margin="3,0,16,0"
                               Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11" />
                    <Button Content="時間順" Padding="10,4" Margin="3,0"
                            Command="{CompiledBinding SortCuesByTimeCommand}" FontSize="11"
                            ToolTip.Tip="キューをトリガー時間順に並べ替える" />
                    <Button Content="＋ 追加" Padding="10,4" Margin="3,0"
                            Command="{CompiledBinding AddCueCommand}" FontSize="11"
                            Classes="accent" />
                    <Button Content="編集" Padding="10,4" Margin="3,0"
                            Command="{CompiledBinding EditCueCommand}"
                            CommandParameter="{Binding #CueList.((vm:CueItemViewModel)SelectedItem).Id}"
                            FontSize="11" />
                    <Button Content="一括編集" Padding="10,4" Margin="3,0"
                            Command="{CompiledBinding BatchEditCuesCommand}"
                            CommandParameter="{Binding #CueList.SelectedItems}"
                            FontSize="11" />
                    <Button Content="複製" Padding="10,4" Margin="3,0"
                            Command="{CompiledBinding DuplicateCueCommand}"
                            CommandParameter="{Binding #CueList.((vm:CueItemViewModel)SelectedItem).Id}"
                            FontSize="11" />
                    <Button Content="連続複製" Padding="10,4" Margin="3,0"
                            Command="{CompiledBinding BatchDuplicateCueCommand}"
                            CommandParameter="{Binding #CueList.((vm:CueItemViewModel)SelectedItem).Id}"
                            FontSize="11" />
                    <Button Content="－ 削除" Padding="10,4" Margin="3,0"
                            Command="{CompiledBinding RemoveCuesCommand}"
                            CommandParameter="{Binding #CueList.SelectedItems}"
                            FontSize="11" />
                </StackPanel>
            </DockPanel>

            <!-- Column headers (WPF GridViewColumnHeader相当) -->
            <Grid Grid.Row="1" Margin="4,0,4,0" ColumnDefinitions="50,130,160,150,70,*">
                <Border Grid.Column="0" Classes="colHeaderCell"><TextBlock Text="有効" Classes="colHeader" /></Border>
                <Border Grid.Column="1" Classes="colHeaderCell"><TextBlock Text="トリガー時間" Classes="colHeader" /></Border>
                <Border Grid.Column="2" Classes="colHeaderCell"><TextBlock Text="名前" Classes="colHeader" /></Border>
                <Border Grid.Column="3" Classes="colHeaderCell"><TextBlock Text="OSCアドレス" Classes="colHeader" /></Border>
                <Border Grid.Column="4" Classes="colHeaderCell"><TextBlock Text="手動" Classes="colHeader" /></Border>
                <Border Grid.Column="5" Classes="colHeaderCell" BorderThickness="0,0,0,1" />
            </Grid>

            <!-- Cue List -->
            <ListBox Grid.Row="2" Name="CueList"
                     ItemsSource="{CompiledBinding CueItems}"
                     SelectionMode="Multiple"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="4,0,4,4"
                     DoubleTapped="CueList_DoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CueItemViewModel">
                        <Grid>
                            <Border Classes="cueRow" Classes.next="{CompiledBinding IsNextCue}">
                                <Grid ColumnDefinitions="50,130,160,150,70,*">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{CompiledBinding IsEnabled, Mode=OneWay}"
                                              Command="{Binding $parent[ListBox].((vm:CueListViewModel)DataContext).ToggleCueEnabledCommand}"
                                              CommandParameter="{CompiledBinding Id}"
                                              HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{CompiledBinding TriggerTime}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="13"
                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{CompiledBinding Name}"
                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock Grid.Column="3" Text="{CompiledBinding OscAddressDisplay}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{StaticResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <Button Grid.Column="4" Content="▶" Padding="8,3" FontSize="11"
                                            HorizontalAlignment="Left" Margin="10,0,0,0"
                                            Command="{Binding $parent[ListBox].((vm:CueListViewModel)DataContext).ManualTriggerCommand}"
                                            CommandParameter="{CompiledBinding Id}" />
                                </Grid>
                            </Border>
                            <Border Classes="flashOverlay" Classes.triggered="{CompiledBinding IsTriggered}"
                                    Background="#DD3333" IsHitTestVisible="False" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>

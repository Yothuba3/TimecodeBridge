<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimecodeBridge.macOS.ViewModels"
        x:Class="TimecodeBridge.macOS.Views.Dialogs.CueEditDialog"
        Title="キュー編集"
        Width="480" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="TextBox.TimeField">
            <Setter Property="Width" Value="48" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.Sep">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
    </Window.Styles>

    <Grid Margin="16" ColumnDefinitions="110,*"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
        <Grid.Styles>
            <Style Selector="Grid > :is(Control)">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </Grid.Styles>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="名前" Classes="Label" />
        <TextBox Grid.Row="0" Grid.Column="1" Name="NameBox" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="トリガー時間" Classes="Label" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <TextBox Name="HoursBox" Classes="TimeField" />
            <TextBlock Text=":" Classes="Sep" />
            <TextBox Name="MinutesBox" Classes="TimeField" />
            <TextBlock Text=":" Classes="Sep" />
            <TextBox Name="SecondsBox" Classes="TimeField" />
            <TextBlock Text=":" Classes="Sep" />
            <TextBox Name="FramesBox" Classes="TimeField" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="キューオフセット" Classes="Label" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <ComboBox Name="OffsetSignBox" Width="60" Margin="0,0,6,0" SelectedIndex="0">
                <ComboBoxItem Content="+" />
                <ComboBoxItem Content="-" />
            </ComboBox>
            <TextBox Name="OffsetHoursBox" Classes="TimeField" />
            <TextBlock Text=":" Classes="Sep" />
            <TextBox Name="OffsetMinutesBox" Classes="TimeField" />
            <TextBlock Text=":" Classes="Sep" />
            <TextBox Name="OffsetSecondsBox" Classes="TimeField" />
            <TextBlock Text=":" Classes="Sep" />
            <TextBox Name="OffsetFramesBox" Classes="TimeField" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="OSCアドレス" Classes="Label" />
        <TextBox Grid.Row="3" Grid.Column="1" Name="OscAddressBox" Watermark="/cue/1" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="TC秒数送信" Classes="Label" />
        <CheckBox Grid.Row="4" Grid.Column="1" Name="SendTcSecondsBox"
                  Content="トリガー時間を秒数(float)で先頭引数に追加" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="OSC引数" Classes="Label" />
        <TextBox Grid.Row="5" Grid.Column="1" Name="OscArgsBox" Watermark="i:1 f:0.5 s:text" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="送信先ホスト" Classes="Label" VerticalAlignment="Top" />
        <Border Grid.Row="6" Grid.Column="1" BorderBrush="#60808080" BorderThickness="1" CornerRadius="3" MinHeight="80">
            <ScrollViewer>
                <ItemsControl Name="HostList" Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostSelection">
                            <CheckBox Content="{CompiledBinding Name}" IsChecked="{CompiledBinding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="メモ" Classes="Label" VerticalAlignment="Top" />
        <TextBox Grid.Row="7" Grid.Column="1" Name="MemoBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />

        <CheckBox Grid.Row="8" Grid.Column="1" Name="EnabledBox" Content="有効" />

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0">
            <Button Name="OkButton" Content="OK" Width="90" IsDefault="True" Click="OnOkClick" />
            <Button Name="CancelButton" Content="キャンセル" Width="90" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>

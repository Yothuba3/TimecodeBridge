<UserControl x:Class="TimecodeBridge.Views.OscTriggerPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
            CornerRadius="8" Margin="4" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: title + mode switch + grid size inputs -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="14" Background="{DynamicResource AccentBrush}"
                            CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="OSCポン出し" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <RadioButton Content="実行" GroupName="PonMode" Margin="0,0,12,0"
                                 VerticalAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 IsChecked="{Binding IsPlayMode}" />
                    <RadioButton Content="編集" GroupName="PonMode" Margin="0,0,18,0"
                                 VerticalAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 IsChecked="{Binding IsEditMode}" />
                    <TextBlock Text="行" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                    <TextBox Text="{Binding Rows, UpdateSourceTrigger=LostFocus}" Width="48"
                             TextAlignment="Center" FontFamily="Consolas"
                             IsEnabled="{Binding IsEditMode}" />
                    <TextBlock Text="列" VerticalAlignment="Center" Margin="12,0,6,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                    <TextBox Text="{Binding Columns, UpdateSourceTrigger=LostFocus}" Width="48"
                             TextAlignment="Center" FontFamily="Consolas"
                             IsEnabled="{Binding IsEditMode}" />
                </StackPanel>
            </DockPanel>

            <!-- Grid of trigger buttons -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4" MinHeight="60"
                                    Command="{Binding DataContext.TriggerCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    PreviewMouseLeftButtonDown="OnCellPreviewMouseLeftButtonDown">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="{Binding DisplayText}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="8" BorderThickness="1.5"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            Padding="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          TextBlock.TextAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                <Setter Property="Content" Value="＋" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

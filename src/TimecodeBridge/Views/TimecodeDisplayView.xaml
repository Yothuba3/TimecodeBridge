<UserControl x:Class="TimecodeBridge.Views.TimecodeDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:TimecodeBridge.Models"
mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="1000"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 状態別色分け: 受信/生成=緑, フリーラン=黄, 喪失/エラー=赤, 停止=灰 -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="#4A4A68" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="受信中">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="生成中">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="フリーラン">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="信号喪失">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="エラー">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LtcOutputIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#4A4A68" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLtcOutputActive}" Value="True">
                    <Setter Property="Fill" Value="#F5B942" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers>
                <!-- モード切替で無効なフィールドのラベルをグレーアウトする -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            Margin="0,0,0,2" Padding="14,10" CornerRadius="8"
            VerticalAlignment="Stretch">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <!-- 信号喪失をタイムコード表示部全体でも警告する -->
                    <DataTrigger Binding="{Binding StatusText}" Value="信号喪失">
                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top: Timecode displays -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- RAW -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="3"
                            Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="RAW" FontFamily="Consolas" FontSize="10"
                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="{Binding RawTimecodeDisplay, FallbackValue='00:00:00:00'}"
                               FontFamily="Consolas" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center" />
                    <!-- 検出フレームレート -->
                    <TextBlock Text="{Binding DetectedFrameRateText}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Bottom" Margin="6,0,0,4" />
                </StackPanel>

                <!-- OFFSET -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2A2A3A" CornerRadius="3"
                            Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="OFS" FontFamily="Consolas" FontSize="10"
                                   FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                    <TextBlock Text="{Binding OffsetTimecodeDisplay, FallbackValue='00:00:00:00'}"
                               FontFamily="Consolas" FontSize="24"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Status + Source (right-aligned) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource StatusIndicatorStyle}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText, FallbackValue='停止'}"
                               Style="{StaticResource ReceiveStatusTextStyle}"
                               VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                    <!-- 信号喪失時の補足（最終受信からの経過秒） -->
                    <TextBlock Text="{Binding SignalDetailText}"
                               Foreground="{DynamicResource ErrorBrush}"
                               VerticalAlignment="Center" FontSize="10" Margin="0,0,12,0" />
                    <RadioButton Content="LTC" GroupName="Source"
                                 IsChecked="{Binding IsLtcMode}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                    <RadioButton Content="内部生成" GroupName="Source"
                                 IsChecked="{Binding IsGeneratorMode}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}"
                    Margin="0,3" VerticalAlignment="Center" />

            <!-- Bottom: Settings Grid -->
            <Grid Grid.Row="2" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: 入力デバイス | フレームレート | オフセット -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="入力デバイス" Style="{StaticResource FieldLabelStyle}"
                           IsEnabled="{Binding IsLtcMode}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding AudioDevices}"
                              SelectedItem="{Binding SelectedDevice}"
                              IsEnabled="{Binding IsLtcMode}"
                              MinWidth="140" HorizontalAlignment="Stretch" />
                    <!-- 更新ボタンは出力デバイス一覧も更新するため生成モードでも有効のまま -->
                    <Button Content="↻" Command="{Binding RefreshAudioDevicesCommand}"
                            Padding="5,2" Margin="4,0,0,0" ToolTip="デバイス一覧を更新"
                            FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="フレームレート" Style="{StaticResource FieldLabelStyle}"
                           IsEnabled="{Binding IsGeneratorMode}" />
                <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding AvailableFrameRates}"
                          SelectedItem="{Binding GeneratorFrameRate}"
                          IsEnabled="{Binding IsGeneratorMode}"
                          ToolTip="生成中の変更は次回リセット時に反映されます"
                          HorizontalAlignment="Left" MinWidth="80" />

                <TextBlock Grid.Row="0" Grid.Column="6" Text="オフセット" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="7" x:Name="OffsetInput"
                         Width="120" FontFamily="Consolas" FontSize="11"
                         Text="{Binding OffsetText, UpdateSourceTrigger=LostFocus}"
                         Padding="4,3" ToolTip="±HH:MM:SS:FF 形式" />

                <!-- Row 2: LTC出力 | 開始時間 | 音量 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="LTC出力" Style="{StaticResource FieldLabelStyle}"
                           IsEnabled="{Binding IsGeneratorMode}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                            IsEnabled="{Binding IsGeneratorMode}">
                    <ComboBox ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice}"
                              ToolTip="生成中の変更は次回リセット時に反映されます"
                              MinWidth="140" HorizontalAlignment="Stretch" />
                    <Ellipse Style="{StaticResource LtcOutputIndicatorStyle}" Margin="6,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="開始時間" Style="{StaticResource FieldLabelStyle}"
                           IsEnabled="{Binding IsGeneratorMode}" />
                <TextBox Grid.Row="2" Grid.Column="4"
                         Text="{Binding GeneratorStartTime, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsGeneratorMode}"
                         HorizontalAlignment="Left" Width="100"
                         FontFamily="Consolas" FontSize="11" Padding="4,3"
                         ToolTip="HH:MM:SS:FF 形式" />

                <TextBlock Grid.Row="2" Grid.Column="6" Text="音量" Style="{StaticResource FieldLabelStyle}"
                           IsEnabled="{Binding IsGeneratorMode}" />
                <Slider Grid.Row="2" Grid.Column="7"
                        Value="{Binding OutputVolumeLevel}" Minimum="0" Maximum="1"
                        Width="100" VerticalAlignment="Center"
                        ToolTip="生成中の変更は次回リセット時に反映されます"
                        IsEnabled="{Binding IsGeneratorMode}" />

                <!-- Row 4: Generator buttons -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="8"
                            Orientation="Horizontal"
                            IsEnabled="{Binding IsGeneratorMode}">
                    <Button Content="▶ 開始" Command="{Binding StartGeneratorCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="10,4" Margin="0,0,6,0" FontSize="11" />
                    <Button Content="■ 停止" Command="{Binding StopGeneratorCommand}"
                            Padding="10,4" Margin="0,0,6,0" FontSize="11" />
                    <Button Content="↺ リセット" Command="{Binding ResetGeneratorCommand}"
                            Padding="10,4" FontSize="11" />
                </StackPanel>
                <!-- Mute Toggle (右端の列に正方形で配置) -->
                <ToggleButton Grid.Row="0" Grid.RowSpan="5" Grid.Column="8"
                              IsChecked="{Binding IsTriggerMuted}"
                              VerticalAlignment="Top"
                              Width="96" Height="96" Margin="16,0,0,0"
                              ToolTipService.ShowDuration="20000"
                              ToolTip="タイムコードによる自動キュー発火のミュート切替。&#10;※手動発火（▶）・OSCポン出し・リレー送信は止まりません">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="MuteBorder"
                                            Background="#2A2040" BorderBrush="#4A4068"
                                            BorderThickness="2" CornerRadius="10"
                                            SnapsToDevicePixels="True">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Ellipse x:Name="MuteDot" Width="14" Height="14"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     Margin="0,0,0,8" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="MuteLabel" Text="LIVE"
                                                       FontFamily="Consolas" FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="MuteBorder" Property="Background" Value="#401A1A" />
                                            <Setter TargetName="MuteBorder" Property="BorderBrush" Value="#EF5A6F" />
                                            <Setter TargetName="MuteDot" Property="Fill" Value="#EF5A6F" />
                                            <Setter TargetName="MuteLabel" Property="Text" Value="MUTE" />
                                            <Setter TargetName="MuteLabel" Property="Foreground" Value="#EF5A6F" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MuteBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="TimecodeBridge.Views.CueEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キュー編集"
        Width="460" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}">

    <Border Margin="12" Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
            CornerRadius="8" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Name -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="名前" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,10" />

            <!-- Trigger Time -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="トリガー時間" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="HoursBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" />
                <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="2" x:Name="MinutesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" />
                <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="4" x:Name="SecondsBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" />
                <TextBlock Grid.Column="5" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="6" x:Name="FramesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" />
            </Grid>

            <!-- Trigger Offset（発火タイミングをずらす） -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="トリガーオフセット" VerticalAlignment="Center" Margin="0,0,0,10"
                       ToolTipService.ShowDuration="20000"
                       ToolTip="発火タイミングを±ずらします。実際の発火時刻 = トリガー時間 ± この値"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="OffsetSignBox" Width="44">
                    <ComboBoxItem Content="+" IsSelected="True" />
                    <ComboBoxItem Content="-" />
                </ComboBox>
                <TextBox Grid.Column="1" x:Name="OffsetHoursBox" TextAlignment="Center" MaxLength="2" Margin="4,0,0,0" FontFamily="Consolas" />
                <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="3" x:Name="OffsetMinutesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" />
                <TextBlock Grid.Column="4" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="5" x:Name="OffsetSecondsBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" />
                <TextBlock Grid.Column="6" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="7" x:Name="OffsetFramesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" />
            </Grid>

            <!-- OSC Address（メイン + 追加アドレス） -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="OSCアドレス" VerticalAlignment="Top" Margin="0,4,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                <TextBox x:Name="OscAddressBox" FontFamily="Consolas" />
                <TextBlock Text="追加アドレス（1行1件・引数なしで一緒に送信されます）"
                           FontSize="10" Margin="0,6,0,2"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox x:Name="AdditionalAddressesBox" FontFamily="Consolas"
                         AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto" />
            </StackPanel>

            <!-- Send Trigger Time as Seconds -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="TC秒数送信" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="SendTcSecondsBox"
                      Content="タイムコードを秒数(float)で先頭引数に追加"
                      Margin="0,0,0,10" />

            <!-- Send Timecode（秒数送信で送る時刻。未指定ならトリガー時間） -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="送信タイムコード" VerticalAlignment="Center" Margin="0,0,0,10"
                       ToolTipService.ShowDuration="20000"
                       ToolTip="秒数送信で送るタイムコード。&#10;未指定ならトリガー時間をそのまま送ります"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                  IsEnabled="{Binding IsChecked, ElementName=SendTcSecondsBox}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="UseSendTimecodeBox" Content="指定"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="OFFの場合はトリガー時間をそのまま送信します" />
                <TextBox Grid.Column="1" x:Name="SendTcHoursBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas"
                         IsEnabled="{Binding IsChecked, ElementName=UseSendTimecodeBox}" />
                <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="3" x:Name="SendTcMinutesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas"
                         IsEnabled="{Binding IsChecked, ElementName=UseSendTimecodeBox}" />
                <TextBlock Grid.Column="4" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="5" x:Name="SendTcSecondsFieldBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas"
                         IsEnabled="{Binding IsChecked, ElementName=UseSendTimecodeBox}" />
                <TextBlock Grid.Column="6" Text=":" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBox Grid.Column="7" x:Name="SendTcFramesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas"
                         IsEnabled="{Binding IsChecked, ElementName=UseSendTimecodeBox}" />
            </Grid>

            <!-- OSC Arguments -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="OSC引数" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="OscArgsBox" FontFamily="Consolas" Margin="0,0,0,10"
                     ToolTip="例: i:1 f:0.5 s:hello (型:値 をスペース区切り、空白を含む文字列は s:&quot;hello world&quot;)" />

            <!-- Target Hosts -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="送信先ホスト" VerticalAlignment="Top" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <!-- チェックのみが選択状態（行選択の青と混同しないようListBoxは使わない） -->
            <Border Grid.Row="7" Grid.Column="1" Height="80" Margin="0,0,0,10"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HostListBox" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" Tag="{Binding Id}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2"
                                              Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoHostsHint" Visibility="Collapsed"
                               Text="ホストが未登録です。&#10;先に「ホスト管理」からホストを追加してください"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Grid>
            </Border>

            <!-- Memo -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="メモ" VerticalAlignment="Top" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="MemoBox" Height="50"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

            <!-- Enabled -->
            <CheckBox Grid.Row="9" Grid.Column="1" x:Name="EnabledBox" Content="有効" Margin="0,0,0,10" />

            <!-- Auto Mute On Fire -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="発火時ミュート" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
            <CheckBox Grid.Row="10" Grid.Column="1" x:Name="AutoMuteBox" Content="このキュー発火時に自動ミュート"
                      Margin="0,0,0,10"
                      ToolTip="発火と同時に、タイムコードによる自動キュー発火をミュートします。&#10;キュー再生中に不慮のTCが飛んできても他のキューが誤発火しないようにする運用向け" />

            <!-- Auto Unmute After -->
            <TextBlock Grid.Row="11" Grid.Column="0" Text="ミュート解除" VerticalAlignment="Center" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12"
                       ToolTip="指定時間の経過後にMUTEを自動解除します。&#10;未指定なら手動で解除するまでミュートを維持します" />
            <Grid Grid.Row="11" Grid.Column="1" Margin="0,0,0,10"
                  IsEnabled="{Binding IsChecked, ElementName=AutoMuteBox}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="UseAutoUnmuteBox" Content="指定" Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          ToolTip="OFFの場合は手動で解除するまでミュートを維持します" />
                <TextBox Grid.Column="1" x:Name="UnmuteHoursBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" Text="00"
                         IsEnabled="{Binding IsChecked, ElementName=UseAutoUnmuteBox}" />
                <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="2,0" />
                <TextBox Grid.Column="3" x:Name="UnmuteMinutesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" Text="00"
                         IsEnabled="{Binding IsChecked, ElementName=UseAutoUnmuteBox}" />
                <TextBlock Grid.Column="4" Text=":" VerticalAlignment="Center" Margin="2,0" />
                <TextBox Grid.Column="5" x:Name="UnmuteSecondsBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" Text="00"
                         IsEnabled="{Binding IsChecked, ElementName=UseAutoUnmuteBox}" />
                <TextBlock Grid.Column="6" Text=":" VerticalAlignment="Center" Margin="2,0" />
                <TextBox Grid.Column="7" x:Name="UnmuteFramesBox" TextAlignment="Center" MaxLength="2" FontFamily="Consolas" Text="00"
                         IsEnabled="{Binding IsChecked, ElementName=UseAutoUnmuteBox}" />
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="OK" Padding="24,8" Margin="0,0,8,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnOkClick" IsDefault="True" />
                <Button Content="キャンセル" Padding="24,8"
                        Click="OnCancelClick" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
